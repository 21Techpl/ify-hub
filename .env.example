# Copy to .env (gitignored) and fill in. NEVER commit real values.
# Pins: requirements.txt; config module (pydantic-settings) arrives with the first src/ PR.
# Tuya Cloud — Access ID/Secret from the Tuya IoT Platform account; keys never leave the server (README invariant).
TUYA_ACCESS_ID=
TUYA_ACCESS_SECRET=
# Owner token: mobile apps authenticate to the hub, never to Tuya.
IFY_OWNER_TOKEN=
